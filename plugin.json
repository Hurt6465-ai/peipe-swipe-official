{
  "id": "nodebb-plugin-peipe-swipe-official",
  "name": "Peipe Swipe Official",
  "description": "Full-screen swipe discovery pages for Peipe. Safe to install alongside nodebb-plugin-peipe-partners.",
  "url": "https://github.com/Hurt6465-ai/peipe-swipe-official",
  "library": "./library.js",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "static:api.routes",
      "method": "addRoutes"
    }
  ],
  "staticDirs": {
    "swipe": "swipe/static"
  },
  "templates": "templates",
  "languages": "languages",
  "scripts": [
    "public/lib/peipe-partners.js",
    "swipe/client.js",
    "swipe/client-v14.js",
    "public/lib/peipe-chat-stickers.js"
  ],
  "scss": [
    "scss/peipe-partners.scss",
    "swipe/style.scss",
    "swipe/v14.scss"
  ]
}
