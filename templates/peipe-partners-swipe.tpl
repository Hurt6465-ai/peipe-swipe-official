<div class="peipe-swipe-page" data-widget-area="peipe-partners-swipe">
  <div class="peipe-swipe-topbar">
    <a class="peipe-swipe-topbtn" href="/" aria-label="[[peipe-partners-swipe:home]]">‹</a>
    <div class="peipe-swipe-title">[[peipe-partners-swipe:title]]</div>
    <a class="peipe-swipe-nearby" href="/nearby">[[peipe-partners-swipe:nearby]]</a>
  </div>

  <div class="peipe-swipe-loading" data-role="loading">
    <div class="peipe-swipe-spinner"></div>
    <div>[[peipe-partners-swipe:loading]]</div>
  </div>

  <div class="peipe-swipe-empty" data-role="empty" hidden>
    <div class="peipe-swipe-empty-title">[[peipe-partners-swipe:emptyTitle]]</div>
    <div class="peipe-swipe-empty-text">[[peipe-partners-swipe:emptyText]]</div>
    <button class="peipe-swipe-primary" type="button" data-action="reload">[[peipe-partners-swipe:retry]]</button>
  </div>

  <div class="swiper peipe-swipe-main" data-role="swiper" hidden>
    <div class="swiper-wrapper" data-role="slides"></div>
  </div>

  <div class="peipe-swipe-toast" data-role="toast" hidden></div>
</div>
